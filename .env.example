# Public Sepolia RPC. Replace it if you have a faster endpoint.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Block the local fork pins to. Keep it fixed so local runs are reproducible.
FORK_BLOCK=11730000

# Local chain
LOCAL_RPC_URL=http://127.0.0.1:8545

# Deployment key for the public testnet. Leave empty to skip testnet deployment.
DEPLOYER_PRIVATE_KEY=

# Optional, only used to verify contracts on the Sepolia explorer.
ETHERSCAN_API_KEY=

# What the interface tells browsers to use. SEPOLIA_RPC_URL is never handed out, because a
# provider url often carries an API key in it. Set this when you run a private endpoint.
PUBLIC_RPC_URL=

# Only for a static build with no indexer. The interface then reads the chain itself.
#   VITE_CHAIN_ID=11155111
#   VITE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
